{
  "name": "viettrails",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "VietTrails - he thong dat va quan ly tour du lich",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
