# Sao chép tệp này thành .env rồi chỉnh theo XAMPP của bạn.
#
# mysql (mặc định) hoặc json (dùng server/data/db.json, phục vụ test/offline).
VIETTRAILS_DB_DRIVER=mysql

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
# Schema riêng của ứng dụng; được tạo tự động nếu chưa có.
# Không dùng "viettrails" để tránh ghi đè cơ sở dữ liệu của bản thử nghiệm cũ.
MYSQL_DATABASE=viettrails_app
